# Copie para .env (uso local com emuladores) OU configure cada um como Firebase Secret em produção:
#   firebase functions:secrets:set NOME_DA_VARIAVEL

# WhatsApp Cloud API (Meta for Developers > seu App > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=escolha-uma-frase-secreta-qualquer
WHATSAPP_OWNER_NUMBER=5511999999999
WHATSAPP_SECRETARY_NUMBER=

# IA (Claude) — console.anthropic.com
ANTHROPIC_API_KEY=

# E-mail (opcional, para "enviar para reembolso por e-mail")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SECRETARY_EMAIL=
FROM_EMAIL=
