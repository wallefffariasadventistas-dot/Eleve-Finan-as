rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Recibos/notas/comprovantes: leitura só para o dono autenticado no dashboard.
    // A escrita é feita pelo backend (Admin SDK) quando o Telegram recebe um arquivo,
    // ou pelo próprio dashboard ao anexar um comprovante em um lançamento manual.
    match /recibos/{despesaId}/{arquivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf|audio/.*');
    }

    // Notas/cupons/recibos do Relatório Fixo Mensal.
    match /notas-fixas/{notaId}/{arquivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
